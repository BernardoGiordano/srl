{
  "name": "srl",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Buildless reactive frontend library, its component collection, its toolchain, and the example application",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BernardoGiordano/srl.git"
  },
  "//workspaces": [
    "The library and CLI are separate packages. Workspaces let the CLI resolve the",
    "same library specifiers in a checkout that consumers install from npm."
  ],
  "workspaces": [
    "source",
    "cli"
  ],
  "scripts": {
    "start": "node cli/dev/serve.mjs --app example --open",
    "serve": "node cli/dev/serve.mjs --app example",
    "build": "node cli/delivery/build.mjs",
    "vendor": "node tools/delivery/vendor.mjs",
    "importmap": "node cli/package/interface.mjs --write",
    "templates": "node cli/delivery/bundle-templates.mjs",
    "package": "node tools/delivery/package-bundle.mjs",
    "package:check": "node tools/delivery/package-bundle.mjs --check",
    "templates:check": "node cli/checks/template-check.mjs",
    "importmap:check": "node cli/checks/importmap-check.mjs",
    "messages:check": "node cli/checks/message-check.mjs",
    "messages:write": "node cli/checks/message-check.mjs --write",
    "pack:check": "node tools/checks/pack-check.mjs",
    "typecheck": "node_modules/tsgo/bin/tsc --noEmit",
    "typecheck:watch": "node_modules/tsgo/bin/tsc --noEmit --watch",
    "typecheck:compat": "node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "web-test-runner",
    "test:tools": "node --test tools/test/*.test.mjs cli/test/*.test.mjs",
    "test:editors": "node --test editors/vscode/test/*.test.cjs",
    "test:artifact": "node --test cli/test/artifact*.test.mjs",
    "test:journey": "node --test cli/test/browser-journey.test.mjs",
    "journey:record": "node tools/browser/record.mjs",
    "test:watch": "web-test-runner --watch",
    "css": "npm run css:example",
    "css:example": "tailwindcss -i ./example/src/app.css -o ./example/app.css --minify",
    "example": "node example/server/server.mjs --open",
    "example:serve": "node example/server/server.mjs",
    "verify": "node tools/checks/verify-deps.mjs",
    "docs:check": "node tools/checks/readme-check.mjs",
    "docs:write": "node tools/checks/readme-check.mjs --write",
    "docs:performance": "node tools/checks/performance-check.mjs",
    "docs:performance:write": "node tools/checks/performance-check.mjs --write",
    "docs:adr": "node tools/checks/adr-check.mjs",
    "docs:adr:write": "node tools/checks/adr-check.mjs --write",
    "docs:browsers": "node tools/checks/browser-check.mjs",
    "docs:browsers:write": "node tools/checks/browser-check.mjs --write",
    "conformance": "node tools/conformance/conformance.mjs",
    "benchmark": "node tools/benchmark/run.mjs",
    "benchmark:ci": "node tools/benchmark/run.mjs --ci",
    "check": "npm run typecheck && npm run templates:check && npm run lint && npm run test:tools && npm run test:editors && npm run vendor && npm run package && npm run verify && npm run pack:check && npm run docs:check && npm run docs:performance && npm run docs:adr && npm run docs:browsers && npm run test"
  },
  "//layout": [
    "source/ holds the library, cli/ the published tools, example/ the application,",
    "and tools/ the checks used only in this repository. See docs/reference/source-layout.md."
  ],
  "//running-it": [
    "npm start serves example/ without an install. Browser runtime dependencies are",
    "committed in source/lib/vendor. Install npm packages to run checks and builds."
  ],
  "//devDependencies": [
    "These packages run type checks, lint, tests, builds, and benchmarks. Browser",
    "runtime files come from the pinned copies in source/lib/vendor.",
    "The CLI pins parse5, TypeScript, and Vite to the same versions listed here."
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@preact/signals-core": "1.14.4",
    "@tailwindcss/browser": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.2",
    "@web/test-runner": "^1.0.0",
    "chrome-launcher": "0.15.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "lit": "3.3.3",
    "parse5": "6.0.1",
    "playwright": "1.63.0",
    "puppeteer-core": "25.4.0",
    "tailwindcss": "4.3.3",
    "tsgo": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.2.1"
  }
}
