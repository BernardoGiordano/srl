{
  // Type checking only. `noEmit` is not a convenience here, it is the whole
  // point: nothing in this project is ever compiled. The browser runs the same
  // .js files that tsc reads, and types live in JSDoc comments plus real .d.ts
  // files that are erased at zero cost because they are never imported at
  // runtime.
  "compilerOptions": {
    "noEmit": true,

    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",

    // Check the JavaScript. Without these two the whole strategy is decorative.
    "allowJs": true,
    "checkJs": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    // Deliberately off: `noImplicitOverride` requires an `@override` JSDoc tag
    // on every member that overrides a base member, and this codebase overrides
    // a lot of Lit lifecycle methods. The tag adds three lines of noise per
    // override and catches a class of mistake that tsc already reports as a
    // signature mismatch.
    "noUnusedLocals": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Explicit rather than "everything in node_modules/@types", so adding a
    // dependency cannot quietly widen the global scope of browser code.
    //
    // `node` is here for tools/*.mjs and the two config files. The cost is that
    // `process` and `Buffer` also type-check inside src/, where they do not
    // exist at runtime. A stricter setup splits browser and tooling into two
    // tsconfigs; that is worth doing when the tooling grows past a few files.
    "types": ["mocha", "node"],

    // These mirror the import map in example/index.html. tsc resolves them to
    // local source; the browser resolves them to the same files over HTTP, where
    // source/lib is mounted at /lib and the application at /.
    //
    // Nothing asserts that the two agree: tools/checks/verify-deps.mjs checks the import
    // map against what the source actually imports, and tools/checks/template-check.mjs
    // type-checks through this file, so a prefix declared here and absent from the
    // map type-checks and then 404s in the browser. The map is the deployed truth;
    // keep this list following it by hand until something compares them.
    //
    // These four are the library and are stable for every application. `@app/` is
    // deliberately absent: a prefix can only mean one directory, so it can point
    // into at most one application's own src/. The application here imports its own
    // files relatively instead, which is what lets one program type-check every
    // application in the repository. An application that wants `@app/` declares it
    // in its own index.html import map and gets its own tsconfig.json in its own
    // folder extending this one — at which point `include` below stops naming it.
    //
    // No `baseUrl`: TypeScript 7.0 removed it (error TS5102). Path targets are
    // now resolved relative to this file, which is what these already assume.
    "paths": {
      "@core/*": ["./source/lib/core/*"],
      "@auth/*": ["./source/lib/auth/*"],
      "@host/*": ["./source/lib/host/*"],
      "@components/*": ["./source/components/*"]
    }
  },
  "include": [
    "source/**/*.js",
    "source/**/*.d.ts",
    // The application imports its own files relatively rather than through `@app/`,
    // precisely so that one program can type-check every application in the
    // repository. A per-application tsconfig overriding `@app/*` is the alternative,
    // and it costs a second typecheck command plus a prefix that means two different
    // directories depending on which file you are reading. Its server is Node rather
    // than browser code and is included as .mjs, like tools/.
    "example/**/*.js",
    "example/**/*.mjs",
    "tools/**/*.mjs",
    "tools/**/*.d.ts",
    // tools/benchmark/browser holds the workload modules Chrome imports over the
    // benchmark origin. They are browser code that happens to live in tools/,
    // because a benchmark is not part of the library and not part of an
    // application, and they resolve `@core/` and `@components/` through the same
    // paths above as the source they measure.
    "tools/**/*.js",
    "*.config.js",
    "*.config.mjs"
  ],
  // source/lib/vendor holds third-party bytes verbatim, and `source/**/*.js` would
  // otherwise pull lit and tailwind-browser into the program: thousands of type
  // errors from files nobody here wrote and the browser never type-checks.
  "exclude": [
    "node_modules",
    "source/lib/vendor",
    // source/dist is the same case one step later: the published bundles, generated
    // by `npm run package` from the sources already in this program. They carry the
    // JSDoc of thirty modules concatenated into one scope, where a `@template T` from
    // one file is out of scope in the next, so type-checking the output would report
    // hundreds of errors about code that type-checks perfectly as input.
    "source/dist",
    "**/app.css",
    // tools/test/fixtures holds fixture projects for the project model's own tests:
    // a computed tag, a `uses` naming a class nothing defines, a definition whose
    // spec is built elsewhere. Being unreadable is what they are for, so they are
    // read as text by a test rather than compiled as source.
    "tools/test/fixtures"
  ]
}
