{
  "name": "@srljs/core",
  "version": "0.9.0",
  "type": "module",
  "license": "MIT",
  "description": "Buildless reactive frontend library: signals, a template dialect checked without a compiler, routing, forms, i18n, auth and micro-frontends, plus a component collection built on it",
  "keywords": [
    "buildless",
    "web-components",
    "custom-elements",
    "signals",
    "spa",
    "import-map",
    "lit",
    "router",
    "forms",
    "micro-frontends"
  ],
  "author": "Bernardo Giordano",
  "homepage": "https://github.com/BernardoGiordano/srl#readme",
  "bugs": "https://github.com/BernardoGiordano/srl/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BernardoGiordano/srl.git",
    "directory": "source"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "//": [
    "This package defines the browser mounts and import prefixes in srl below.",
    "The import map and Node bundles are derived from that table. The explicit",
    "exports also give the CLI the small set of source modules it needs.",
    "Run npm run package before publishing so every dist target exists."
  ],
  "exports": {
    ".": { "types": "./dist/srl-core.d.ts", "default": "./dist/srl-core.js" },
    "./components": { "types": "./dist/srl-components.d.ts", "default": "./dist/srl-components.js" },
    "./dist/*": "./dist/*",
    "./lib/core/elements/style-scope.js": "./lib/core/elements/style-scope.js",
    "./lib/core/remotes/manifest-policy.js": "./lib/core/remotes/manifest-policy.js",
    "./lib/core/template/dialect.js": "./lib/core/template/dialect.js",
    "./lib/core/template/expression-parser.js": "./lib/core/template/expression-parser.js",
    "./lib/core/localization/types.js": { "types": "./lib/core/localization/types.d.ts" },
    "./lib/core/remotes/types.js": { "types": "./lib/core/remotes/types.d.ts" },
    "./lib/core/template/types.js": { "types": "./lib/core/template/types.d.ts" },
    "./testing/harness.js": "./lib/test/harness.js",
    "./importmap.json": "./lib/importmap.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "//sideEffects": [
    "Component modules register custom elements when imported. Bundlers must keep",
    "those imports even when no exported value is used."
  ],
  "sideEffects": true,
  "//files": [
    "Publish the library, components, generated bundles, and shared tsconfig.",
    "Tests stay out of the tarball except for the public browser test harness."
  ],
  "files": [
    "dist",
    "lib",
    "components",
    "tsconfig.base.json",
    "!**/test/**",
    "lib/test/harness.js"
  ],
  "//dependencies": [
    "Node and bundler consumers install the same pinned Lit and signals versions",
    "that the browser import map serves from lib/vendor."
  ],
  "dependencies": {
    "@preact/signals-core": "1.14.4",
    "lit": "3.3.3"
  },
  "//srl": [
    "mounts maps browser URL prefixes to package directories. imports maps bare",
    "specifiers to those directories. bundles names the generated registry",
    "entries. vendor maps third-party specifiers to committed browser files."
  ],
  "srl": {
    "mounts": {
      "/lib/": "lib",
      "/components/": "components"
    },
    "imports": {
      "@core/": "lib/core",
      "@auth/": "lib/auth",
      "@host/": "lib/host",
      "@components/": "components"
    },
    "bundles": {
      "srl-core": {
        "subpath": ".",
        "imports": ["@core/", "@auth/", "@host/"]
      },
      "srl-components": {
        "subpath": "./components",
        "imports": ["@components/"],
        "extends": "srl-core",
        "exclude": ["components/internal"]
      }
    },
    "vendor": {
      "lit": "/lib/vendor/lit-all.min.js",
      "lit/async-directive.js": "/lib/vendor/lit-all.min.js",
      "lit/directives/repeat.js": "/lib/vendor/lit-all.min.js",
      "@preact/signals-core": "/lib/vendor/signals-core.mjs"
    }
  }
}
